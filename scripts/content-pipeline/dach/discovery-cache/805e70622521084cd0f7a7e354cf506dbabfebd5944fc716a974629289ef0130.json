lug\":\"marine-protected-areas\"},{\"url\":\"https://www.protectedplanet.net/en/thematic-areas/internationally-designated-areas\",\"linkTitle\":\"View the Internationally Designated Areas page\",\"label\":\"Internationally Designated Areas\",\"imageUrl\":\"\",\"summary\":\"\",\"pasNo\":-1,\"slug\":\"internationally-designated-areas\"},{\"url\":\"https://www.protectedplanet.net/en/thematic-areas/territories-and-areas-governed-by-indigenous-peoples-and-local-communities\",\"linkTitle\":\"View the Territories and areas governed by Indigenous Peoples and local communities page\",\"label\":\"Territories and areas governed by Indigenous Peoples and local communities\",\"imageUrl\":\"\",\"summary\":\"Guidance on the reporting of territories and areas conserved by Indigenous Peoples and local communities \",\"pasNo\":-1,\"slug\":\"territories-and-areas-governed-by-indigenous-peoples-and-local-communities\"},{\"url\":\"https://www.protectedplanet.net/en/thematic-areas/protected-and-conserved-area-effectiveness\",\"linkTitle\":\"View the Effectiveness page\",\"label\":\"Effectiveness\",\"imageUrl\":\"/rails/active_storage/blobs/redirect/eyJfcmFpbHMiOnsiZGF0YSI6OTcyLCJwdXIiOiJibG9iX2lkIn19--4f7f382b4e3edc674471cff7771d4b4fd1b7e7c9/greenlist-hero.jpg\",\"summary\":\"\",\"pasNo\":-1,\"slug\":\"protected-and-conserved-area-effectiveness\"},{\"url\":\"https://www.protectedplanet.net/en/thematic-areas/equity\",\"linkTitle\":\"View the Equitable Governance page\",\"label\":\"Equitable Governance\",\"imageUrl\":\"/rails/active_storage/blobs/redirect/eyJfcmFpbHMiOnsiZGF0YSI6OTczLCJwdXIiOiJibG9iX2lkIn19--27046543cec1a295416580f8f10e28e1d8cb4b64/PPLIVE2018_Box11_fg1.png\",\"summary\":\"Equity relates to how fairly a protected area is governed: who has a say in decisions, how decisions are taken, and how the costs and benefits are shared.\",\"pasNo\":-1,\"slug\":\"equity\"},{\"url\":\"https://www.protectedplanet.net/en/thematic-areas/connectivity-conservation\",\"linkTitle\":\"View the Connectivity page\",\"label\":\"Connectivity\",\"imageUrl\":\"/rails/active_storage/blobs/redirect/eyJfcmFpbHMiOnsiZGF0YSI6OTEwLCJwdXIiOiJibG9iX2lkIn19--07f6a2264faee66e599367a93ca7637bb704f093/%5BCONNECT%5D%20AdobeStock_217436188-min.jpeg\",\"summary\":\"Beyond protected and conserved areas what is the contribution of ecological corridors to achieving global conservation goals?\",\"pasNo\":-1,\"slug\":\"connectivity-conservation\"}]}'></div>\n</div>\n</div>\n<section class=\"vw-partials-ctas-protected-planet-report\">\n<div class=\"vw-partials-ctas-protected-planet-report__container\">\n<span class=\"vw-partials-ctas-protected-planet-report__ribbon\">\n          Updated\n        </span>\n<div class=\"vw-partials-ctas-protected-planet-report__content\">\n<div class=\"vw-partials-ctas-protected-planet-report__text\">\n<h2 class=\"vw-partials-ctas-protected-planet-report__title\">\n            Protected Planet Report 2024\n          </h2>\n<p class=\"vw-partials-ctas-protected-planet-report__intro\">\n            Tracking progress towards global targets for protected and conserved areas.\n          </p>\n</div>\n<a class=\"vw-partials-ctas-protected-planet-report__button\" href=\"https://digitalreport.protectedplanet.net/\" target=\"_blank\">Explore Report</a>\n</div>\n</div>\n</section>\n</div>\n<footer class=\"vw-partials-footer\">\n<div class=\"vw-partials-footer__container\">\n<div class=\"vw-partials-footer__col vw-partials-footer__col--hide-below-desktop\">\n<a class=\"vw-layouts-partials-topbar__logo\" href=\"/en\" title=\"Visit: Protected Planet\">\n<i alt=\"Protected Planet logo\" class=\"vw-partials-global-site-logo__icon--footer\"></i>\n</a>\n</div>\n<div class=\"vw-partials-footer__col\">\n<h3 class=\"vw-partials-footer__title\">\n<span class=\"translation_missing\" title=\"translation missing: en.global.footer.explore\">Explore</span>\n</h3>\n<a class=\"vw-partials-footer__link\" href=\"/en/resources\" title=\"Visit: Resources\">Resources</a>\n<a class=\"v