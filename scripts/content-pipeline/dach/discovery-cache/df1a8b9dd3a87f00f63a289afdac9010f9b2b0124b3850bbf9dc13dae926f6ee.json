-blur=\"true\"><span></span></button><a class=\"rd-navbar-brand brand\" href=\"index.php?id=2\"><img alt=\"\" src=\"images/logo_ersatz.png\"/></a>\n</div>\n<!-- OOOO Logo Stop OOOOO-->\n</div>\n</div>\n</nav>\n</div>\n</header>\n<!-- Banner START -->\n<div class=\"frame frame-default frame-type-html frame-layout-0\" id=\"c37\">\n<section>\n<div class=\"swiper-container swiper-slider swiper-variant-1 bg-gray-base\" data-autoplay=\"false\" data-loop=\"false\" data-simulate-touch=\"true\">\n<div class=\"swiper-wrapper text-center\">\n<div class=\"swiper-slide\" data-slide-bg=\"https://naturpark-nlh.de/fileadmin/Banner/Banner001-Startseite-Homebutton.jpg\">\n<div class=\"swiper-slide-caption\">\n<div class=\"shell\">\n<div class=\"range range-sm-center range-lg-right text-lg-right\">\n<div class=\"cell-sm-11 cell-md-10 cell-lg-6\">\n<h2 class=\"slider-header\" data-caption-animate=\"fadeInUp\" data-caption-delay=\"0s\">Willkommen in derNiederlausitzer Heidelandschaft!</h2>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"swiper-scrollbar veil-lg\"></div>\n<div class=\"swiper-nav-wrap veil reveal-lg-block\">\n<div class=\"swiper-button-prev\"></div>\n<div class=\"swiper-button-next\"></div>\n</div>\n</div>\n</section>\n</div>\n<!-- Banner STOP -->\n<section class=\"section-30 section-sm-30 section-sm-bottom-30\">\n<div class=\"shell text-left\">\n<div class=\"breadcrump\"> <a href=\"https://natur.flavor-server.de/index.php?id=2\">Naturpark NLH</a>  &gt;   </div>\n<div class=\"range range-sm-center range-md-left\">\n<!-- Section drueber START -->\n<section class=\"section-30 section-sm-30 section-sm-bottom-30\">\n<div class=\"shell text-left\">\n<div class=\"frame frame-default frame-type-header frame-layout-0\" id=\"c86\">\n<header>\n<h4 class=\"\">\n                Ganz im Süden Brandenburgs verbirgt sich ein wahrer Schatz – der Naturpark Niederlausitzer Heidelandschaft!\n            </h4>\n</header>\n</div>\n<div class=\"frame frame-default frame-type-textmedia frame-layout-0 frame-space-before-extra-small frame-space-after-medium\" id=\"c85\">\n<div class=\"ce-textpic ce-right ce-intext\">\n<div class=\"ce-gallery\" data-ce-columns=\"1\" data-ce-images=\"1\">\n<div class=\"ce-row\">\n<div class=\"ce-column\">\n<figure class=\"video\">\n<div class=\"video-embed\">\n<video autoplay=\"\" class=\"video-embed-item\" controls=\"\" loop=\"\" muted=\"\" no-cookie=\"\" playsinline=\"\" title=\"Imagefilm\" width=\"600\"><source src=\"/fileadmin/video/Imagefilm%2016-9%20hochaufloesendneueMusik07.mp4\" type=\"video/mp4\"/></video>\n</div>\n</figure>\n</div>\n</div>\n</div>\n<div class=\"ce-bodytext\">\n<p>Weite Wälder, blühende Heideflächen, bizarre Bergbaufolgelandschaften, romantische Streuobstwiesen und geheimnisvolle Moorgebiete: Die Landschaften des Naturparks sind vielfältig und blicken auf eine bewegte Geschichte zurück. Über Jahrhunderte hinweg wirkte der Mensch auf das Landschaftsbild ein – veränderte, wandelte und formte es. Viele Spuren dieses stetigen Prozesses sind noch heute sichtbar.</p>\n<p>Werden Sie aktiv und entdecken Sie die Vielzahl an landschaftlichen und kulturhistorischen Kleinoden zu Fuß, auf dem Fahrrad oder vom Kremser aus. Bei schlechtem Wetter locken Museen und regionale Gastronomien mit interessanten Eindrücken, Leckereien und einem Dach über dem Kopf.</p>\n<p>Rund eine Stunde von Dresden und etwa 2 Stunden von Berlin bietet diese noch wenig besuchte Kulturlandschaft all jenen, die Erholung abseits vom Massentourismus in der Natur schätzen, genau das Richtige. Wir laden Sie ein, sich verzaubern zu lassen!</p>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Section drueber STOP -->\n<!-- Spalte links START -->\n<div class=\"cell-sm-9 cell-md-6\">\n<div class=\"frame frame-default frame-type-list frame-layout-0\" id=\"c193\">\n<div class=\"news\">\n<!--TYPO3SEARCH_end-->\n<div class=\"news-list-view\" id=\"news-container-193\">\n<!--\n\t=====================\n\t\tPartials/List/Item.html\n-->\n<div class=\"article articletype-0\" itemscope=\"itemscope\" itemtype=\"https://schema.org/Article\">\n<!-- header -->\n<div class=\"header\">\n<h3>\n<a href=\"/aktuelles/aktuelles-details?tx_news_pi1%5Baction%5D=detail&amp;tx_news_pi1%5Bcontroller%5D=News&amp;tx_news_pi1%5Bnews%5D=239&amp;cHash=0e80bb4a99cf2d1fd2c7d8449033cf31\" itemprop=\"url\" title=\"PlanBIO: Biodiversität entdecken – Baum für Baum\">\n<span itemprop=\"headline\">PlanBIO: Biodiversität entdecken – Baum für Baum</span>\n</a>\n</h3>\n</div>\n<div class=\"news-img-wrap\">\n<a href=\"/aktuelles/aktuelles-details?tx_news_pi1%5Baction%5D=detail&amp;tx_news_pi1%5Bcontroller%5D=News&amp;tx_news_pi1%5Bnews%5D=239&amp;cHash=0e80bb4a99cf2d1fd2c7d8449033cf31\" title=\"PlanBIO: Biodiversität entdecken – Baum für Baum\">\n<img alt=\"\" height=\"570\" loading=\"lazy\" src=\"/fileadmin/_processed_/f/f/csm_Buntspecht_Raul_Koehler_068fee6bd9.jpg\" width=\"570\"/>\n</a>\n</div>\n<!-- teaser -->\n<div class=\"teaser-text\">\n<div itemprop=\"description\"><p>Ein neues Projekt lädt Bürger:innen in Südbrandenburg ein, wertvolle Lebensräume an Bäumen zu erfassen und die biologische Vielfalt zu schützen.</p></div>\n<a class=\"more\" href=\"/aktuelles/aktuelles-details?tx_news_pi1%5Baction%5D=detail&amp;tx_news_pi1%5Bcontroller%5D=News&amp;tx_news_pi1%5Bnews%5D=239&amp;cHash=0e80bb4a99cf2d1fd2c7d8449033cf31\" title=\"PlanBIO: Biodiversität entdecken – Baum für Baum\">\n\t\t\tWeiterlesen\n\t\t</a>\n</div>\n<!-- footer information -->\n<div class=\"footer\">\n<p>\n<!-- date -->\n<span class=\"news-list-date\">\n<time datetime=\"2026-11-10\" itemprop=\"datePublished\">\n\t\t\t\t\t10. November 2026\n\t\t\t\t</time>\n</span>\n<!-- first category -->\n<span class=\"news-list-category\">Aktuelles</span>\n<!-- author -->\n</p>\n</div>\n</div>\n</div>\n<!--TYPO3SEARCH_begin-->\n</div>\n</div>\n</div>\n<!-- Spalte links STOP -->\n<!-- Spalte rechts START -->\n<div class=\"cell-sm-9 cell-md-6 offset-top-30 offset-md-top-0\">\n<div class