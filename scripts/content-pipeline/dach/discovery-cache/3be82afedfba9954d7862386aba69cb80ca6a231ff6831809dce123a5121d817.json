js-icon--instagram\" data-media=\"instagram\"></button>\n<a data-mailto-token=\"ocknvq,?uwdlgev=Fcu%42m%E5%D8ppvg%42Fkej%42kpvgtguukgtgp&amp;dqfa=Fkgug%42Ugkvg%42kuv%42kpvgtguucpv%5C%42jvvru%5C%4H%4Hyyy0pcvkqpcnrctm/xqtrqoogtuejg/dqffgpncpfuejchv0fg%4Hgp%4H\" data-mailto-vector=\"2\" href=\"#\" title=\"E-mail\"><span>email</span></a>\n</div>\n<div class=\"m-layer-wrapper js-layers\">\n<div class=\"m-layer\" data-media=\"fb\">\n<a href=\"https://www.facebook.com/sharer/sharer.php?u=https://www.nationalpark-vorpommersche-boddenlandschaft.de/en/\" title=\"Share this page on Facebook\">\n                        Share this page on Facebook\n                    </a>\n<a href=\"https://www.facebook.com/Nationalpark-Vorpommersche-Boddenlandschaft-156354801193472/\" target=\"_blank\" title=\"Visit our Facebook page\">\n                            Visit our Facebook page\n                        </a>\n</div>\n<div class=\"m-layer\" data-media=\"instagram\">\n<a href=\"https://www.instagram.com/nationalparkboddenlandschaft/\" target=\"_blank\" title=\"Visit our Instagram page\">\n                            Visit our Instagram page\n                        </a>\n</div>\n</div>\n</div>\n<!-- end: mod-socialmedia //-->\n</div>\n</div>\n<!-- end: mod-nav-breadcrumb //-->\n<!--TYPO3SEARCH_begin-->\n<div class=\"l-content\" id=\"content\">\n<!--DMAILER_SECTION_BOUNDARY_-->\n<!-- begin: mod-headline data-js-headline //-->\n<div class=\"mod-headline mk-top mk-grid-12-10-8\" id=\"c1727\">\n<div class=\"m-wrapper mk-padding\">\n<h1 style=\"color: {$plugin.tx_naturlandschaften.settings.uids.color}\">Welcome to the wilderness by the sea</h1>\n</div>\n</div>\n<!-- end: mod-headline //-->\n<!--DMAILER_SECTION_BOUNDARY_END-->\n<!--DMAILER_SECTION_BOUNDARY_-->\n<!-- begin: mod-copytext data-js-copytext //-->\n<div class=\"mod-copytext mk-top mk-grid-12-10-8\" id=\"c2024\">\n<div class=\"m-wrapper mk-padding\">\n<p>The largest national park on Germany's Baltic coast combines the roar of the wild and the sound of silence. It's famous for the Baltic Sea's unique lagoons – the „Bodden“ – and a constantly changing coastline. Over the centuries, the area has created an impressive mosaic of habitats with a diverse flora and fauna. Here, nature is allowed to develop within its own rules, true to the philosophy of all 16 of Germany's national parks: „Let nature be nature“.</p>\n</div>\n</div>\n<!-- end: mod-Textfeld //-->\n<!--DMAILER_SECTION_BOUNDARY_END-->\n<!--DMAILER_SECTION_BOUNDARY_-->\n<!-- begin: mod-infotainment data-js-infotainment //-->\n<div class=\"mod-infotainment mk-top\" id=\"c2433\">\n<div class=\"m-flex-wrapper mk-padding\">\n<div class=\"m-button\">\n<a href=\"/en/knowledge-understanding/the-national-park/profile\">\n<div class=\"m-headline\">786</div>\n<div class=\"m-text\"><p>km² is the size of Germany's third largest national park. </p></div>\n<div class=\"m-arrow\"></div>\n</a>\n</div>\n<div class=\"m-button\">\n<a href=\"/en/knowledge-understanding/the-national-park/profile\">\n<div class=\"m-headline\">83%</div>\n<div class=\"m-text\"><p>is made up of the Baltic Sea, tidal flats and lagoons. </p></div>\n<div class=\"m-arrow\"></div>\n</a>\n</div>\n<div class=\"m-button\">\n<a href=\"/en/knowledge-understanding/the-national-park/profile\">\n<div class=\"m-headline\">1990</div>\n<div class=\"m-text\"><p>the national park was established. </p></div>\n<div class=\"m-arrow\"></div>\n</a>\n</div>\n</div>\n</div>\n<!-- end: mod-infotainment //-->\n<!--DMAILER_SECTION_BOUNDARY_END-->\n<!--DMAILER_SECTION_BOUNDARY_-->\n<div class=\"news-list-view\">\n</div>\n<!--DMAILER_SECTION_BOUNDARY_END-->\n<!--DMAILER_SECTION_BOUNDARY_-->\n<!-- begin: mod-buttonteaserrow data-js-buttonteaserrow //-->\n<!-- begin: mod-buttonteaserrow data-js-buttonteaserrow //-->\n<div class=\"mod-buttonteaserrow mk-top\" data-js-buttonteaserrow=\"\">\n<div class=\"m-header mk-padding mk-grid-12-10-8\">\n<span class=\"m-headline\">Chosen for you</span>\n</div>\n<div class=\"m-swiper-wrapper\">\n<div class=\"swiper-container\">\n<div class=\"swiper-wrapper\">\n<!--DMAILER_SECTION_BOUNDARY_-->\n<!-- begin: mod-buttonteaserrow-text data-js-buttonteaserrow-text //-->\n<!-- start: If Button Teaser Swiper is On //-->\n<div class=\"swiper-slide\">\n<!-- end: If Button Teaser Swiper is On //-->\n<div class=\"mod-buttonteaserrow-bild\">\n<div class=\"m-wrapper mk-padding\">\n<a href=\"/en/experience-recuperate/out-and-about-in-nature\">\n<h2><span>Experience the national park</span></h2>\n<figure>\n<picture>\n<img alt=\"Aussichts-Plattform Hohe Düne auf dem Zingst in der Kernzone des Nationalparks\" loading=\"lazy\" src=\"/fileadmin/_processed_/7/7/csm_J_Bassek_Plattform_Hohe_Duene_32b97c8f33.jpg\"/>\n</picture>\n<small class=\"m-copy\"><span>© J. Bassek</span></small>\n<figcaption><div><p class=\"MsoPlainText\">28 viewing platforms, 143 km of hiking/85 km of cycling trails with 131 signposts let you experience the national park.</p></div></figcaption>\n</figure>\n</a>\n</div>\n</div>\n<!-- start: If Button Teaser Swiper is On //-->\n</div>\n<!-- end: If Button Teaser Swiper is On //-->\n<!-- end: mod-buttonteaserrow-text //-->\n<!--DMAILER_SECTION_BOUNDARY_END-->\n</div>\n</div>\n<!-- Add Arrows -->\n<div class=\"m-button swiper-button-next\"> <span class=\"m-arrow m-arrow--right\"></span></div>\n<div class=\"m-button swiper-button-prev\"> <span class=\"m-arrow m-arrow--right\"></span></div>\n</div>\n</div>\n<!-- end: mod-buttonteaserrow data-js-buttonteaserrow //-->\n<!--DMAILER_SECTION_BOUNDARY_END-->\n</div>\n<!--TYPO3SEARCH_end-->\n</main>\n<!-- end: lay-main //-->\n<!-- begin: lay-footer //-->\n<footer class=\"lay-footer\">\n<!-- begin: mod-footer data-js-footer //-->\n<div class=\"mod-footer mk-top\" id=\"footer\">\n<div class=\"m-wrapper mk-padding\">\n<div class=\"m-flex-wrapper\">\n<!-- begin: mod-footer data-js-footer //-->\n<div class=\"mod-footer-social\">\n<div class=\"m-flex-wrapper\">\n<a class=\"m-icon m-instagram\" href=\"http