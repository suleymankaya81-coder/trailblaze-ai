data-js-socialmedia=\"\">\n<div class=\"m-flex-icons\">\n<button aria-label=\"Facebook\" class=\"js-icon\" data-media=\"fb\"></button>\n<a data-mailto-token=\"ocknvq,?uwdlgev=Fcu%42m%E5%D8ppvg%42Fkej%42kpvgtguukgtgp&amp;dqfa=Fkgug%42Ugkvg%42kuv%42kpvgtguucpv%5C%42jvvru%5C%4H%4Hyyy0pcvkqpcnrctm/lcuowpf0fg%4Hgp%4H\" data-mailto-vector=\"2\" href=\"#\" title=\"E-mail\"><span>email</span></a>\n</div>\n<div class=\"m-layer-wrapper js-layers\">\n<div class=\"m-layer\" data-media=\"fb\">\n<a href=\"https://www.facebook.com/sharer/sharer.php?u=https://www.nationalpark-jasmund.de/en/\" title=\"Share this page on Facebook\">\n                        Share this page on Facebook\n                    </a>\n</div>\n</div>\n</div>\n<!-- end: mod-socialmedia //-->\n</div>\n</div>\n<!-- end: mod-nav-breadcrumb //-->\n<!--TYPO3SEARCH_begin-->\n<div class=\"l-content\" id=\"content\">\n<!--DMAILER_SECTION_BOUNDARY_-->\n<!-- begin: mod-headline data-js-headline //-->\n<div class=\"mod-headline mk-top mk-grid-12-10-8\" id=\"c2440\">\n<div class=\"m-wrapper mk-padding\">\n<h1 style=\"color: {$plugin.tx_naturlandschaften.settings.uids.color}\">Welcome to the smallest german National Park</h1>\n</div>\n</div>\n<!-- end: mod-headline //-->\n<!--DMAILER_SECTION_BOUNDARY_END-->\n<!--DMAILER_SECTION_BOUNDARY_-->\n<!-- begin: mod-copytext data-js-copytext //-->\n<div class=\"mod-copytext mk-top mk-grid-12-10-8\" id=\"c2441\">\n<div class=\"m-wrapper mk-padding\">\n<p><strong>The largest beech forests on the Baltic coast </strong>stretch here over hills and stream valleys, enclosing sparse bogs and springs. On the <strong>famous white chalk coast</strong>, shady green forests meet the blue of the sea. <strong>UNESCO</strong> ennobled the rustic old beech forests in the heart of the national park as a <strong>world heritage site</strong>. Together with many partners and supporters, we ensure that this natural treasure is preserved <strong>for future generations</strong>.</p>\n<p>Your team of the <a class=\"m-arrow\" href=\"https://www.nationalpark-jasmund.de/en/service/contacts\" target=\"_blank\" title=\"Contact\">National Park Authority</a></p>\n</div>\n</div>\n<!-- end: mod-Textfeld //-->\n<!--DMAILER_SECTION_BOUNDARY_END-->\n<!--DMAILER_SECTION_BOUNDARY_-->\n<!-- begin: mod-infotainment data-js-infotainment //-->\n<div class=\"mod-infotainment mk-top\" id=\"c2442\">\n<div class=\"m-flex-wrapper mk-padding\">\n<div class=\"m-button\">\n<a href=\"/en/\">\n<div class=\"m-headline\">493 ha</div>\n<div class=\"m-text\"><p>Beech forests in the heart of the park are UNESCO World Heritage Site. </p></div>\n<div class=\"m-arrow\"></div>\n</a>\n</div>\n<div class=\"m-button\">\n<a href=\"/en/\">\n<div class=\"m-headline\">161 m</div>\n<div class=\"m-text\"><p>high is the highest elevation, the Pieckberg </p></div>\n<div class=\"m-arrow\"></div>\n</a>\n</div>\n<div class=\"m-button\">\n<a href=\"/en/\">\n<div class=\"m-headline\">70 Mio</div>\n<div class=\"m-text\"><p>years old is the chalk. </p></div>\n<div class=\"m-arrow\"></div>\n</a>\n</div>\n</div>\n</div>\n<!-- end: mod-infotainment //-->\n<!--DMAILER_SECTION_BOUNDARY_END-->\n<!--DMAILER_SECTION_BOUNDARY_-->\n<!-- begin: mod-copytext data-js-copytext //-->\n<div class=\"mod-copytext mk-top mk-grid-12-10-8\" id=\"c2451\">\n<div class=\"m-wrapper mk-padding\">\n<h2 class=\"text-center\"><strong><a class=\"m-arrow\" href=\"https://www.nationalpark-jasmund.de/presse\" target=\"_blank\" title=\"Webseite Nationalpark JAS\"><strong>News</strong></a></strong></h2>\n</div>\n</div>\n<!-- end: mod-Textfeld //-->\n<!--DMAILER_SECTION_BOUNDARY_END-->\n<!--DMAILER_SECTION_BOUNDARY_-->\n<!-- begin: mod-buttonteaserrow data-js-buttonteaserrow //-->\n<!-- begin: mod-buttonteaserrow data-js-buttonteaserrow //-->\n<div class=\"mod-buttonteaserrow mk-top\" data-js-buttonteaserrow=\"\">\n<div class=\"m-header mk-padding mk-grid-12-10-8\">\n<span class=\"m-headline\"></span>\n</div>\n<div class=\"m-swiper-wrapper\">\n<div class=