{"status": 200, "url": "https://www.naturpark-duemmer.de/", "body": "<!DOCTYPE html>\n\n<html lang=\"de\">\n<head>\n<meta charset=\"utf-8\"/>\n<title>Startseite - Naturpark Dümmer</title>\n<base href=\"https://www.naturpark-duemmer.de/\"/>\n<meta content=\"index,follow\" name=\"robots\"/>\n<meta content=\"\" name=\"description\"/>\n<meta content=\"Contao Open Source CMS\" name=\"generator\"/>\n<meta content=\"Naturpark Dümmer\" property=\"og:site_name\"/>\n<meta content=\"website\" property=\"og:type\"/>\n<meta content=\"Startseite - Naturpark Dümmer\" property=\"og:title\"/>\n<meta content=\"https://www.naturpark-duemmer.de/\" property=\"og:url\"/>\n<meta content=\"https://www.naturpark-duemmer.de//files/public/header/titel%20startseite.jpg\" property=\"og:image\"/>\n<!-- Favicons -->\n<link href=\"/files/util/img/favicons/apple-touch-icon-57x57.png\" rel=\"apple-touch-icon\" sizes=\"57x57\"/>\n<link href=\"/files/util/img/favicons/apple-touch-icon-60x60.png\" rel=\"apple-touch-icon\" sizes=\"60x60\"/>\n<link href=\"/files/util/img/favicons/apple-touch-icon-72x72.png\" rel=\"apple-touch-icon\" sizes=\"72x72\"/>\n<link href=\"/files/util/img/favicons/apple-touch-icon-76x76.png\" rel=\"apple-touch-icon\" sizes=\"76x76\"/>\n<link href=\"/files/util/img/favicons/apple-touch-icon-114x114.png\" rel=\"apple-touch-icon\" sizes=\"114x114\"/>\n<link href=\"/files/util/img/favicons/apple-touch-icon-120x120.png\" rel=\"apple-touch-icon\" sizes=\"120x120\"/>\n<link href=\"/files/util/img/favicons/apple-touch-icon-144x144.png\" rel=\"apple-touch-icon\" sizes=\"144x144\"/>\n<link href=\"/files/util/img/favicons/apple-touch-icon-152x152.png\" rel=\"apple-touch-icon\" sizes=\"152x152\"/>\n<link href=\"/files/util/img/favicons/apple-touch-icon-180x180.png\" rel=\"apple-touch-icon\" sizes=\"180x180\"/>\n<link href=\"/files/util/img/favicons/favicon-32x32.png\" rel=\"icon\" sizes=\"32x32\" type=\"image/png\"/>\n<link href=\"/files/util/img/favicons/android-chrome-192x192.png\" rel=\"i