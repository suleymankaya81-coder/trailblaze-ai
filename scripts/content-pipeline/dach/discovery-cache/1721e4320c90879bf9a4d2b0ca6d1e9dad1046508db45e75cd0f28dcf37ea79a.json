aland“ e.V.\" property=\"og:site_name\"/>\n<meta content=\"2024-04-05T09:15:47+00:00\" property=\"article:published_time\"/>\n<meta content=\"https://www.naturpark-saale-unstrut.de/wp-content/uploads/2024/04/Erdkroeten-Laichen-scaled-1.jpg\" property=\"og:image\"/>\n<meta content=\"2560\" property=\"og:image:width\"/>\n<meta content=\"1438\" property=\"og:image:height\"/>\n<meta content=\"image/jpeg\" property=\"og:image:type\"/>\n<meta content=\"cmdadmin\" name=\"author\"/>\n<meta content=\"summary_large_image\" name=\"twitter:card\"/>\n<meta content=\"Verfasst von\" name=\"twitter:label1\"/>\n<meta content=\"cmdadmin\" name=\"twitter:data1\"/>\n<meta content=\"Geschätzte Lesezeit\" name=\"twitter:label2\"/>\n<meta content=\"1 Minute\" name=\"twitter:data2\"/>\n\n<!-- / Yoast SEO plugin. -->\n<link href=\"https://www.naturpark-saale-unstrut.de/feed/\" rel=\"alternate\" title=\"Geo-Naturpark „Saale-Unstrut-Trialand“ e.V. » Feed\" type=\"application/rss+xml\"/>\n<link href=\"https://www.naturpark-saale-unstrut.de/comments/feed/\" rel=\"alternate\" title=\"Geo-Naturpark „Saale-Unstrut-Trialand“ e.V. » Kommentar-Feed\" type=\"application/rss+xml\"/>\n<link href=\"https://www.naturpark-saale-unstrut.de/wp-json/oembed/1.0/embed?url=https%3A%2F%2Fwww.naturpark-saale-unstrut.de%2Fentwicklung-ehemaliger-forellenteichkulisse-als-laichhabitate-fuer-amphibien-und-trittsteinbiotop%2F\" rel=\"alternate\" title=\"oEmbed (JSON)\" type=\"application/json+oembed\"/>\n<link href=\"https://www.naturpark-saale-unstrut.de/wp-json/oembed/1.0/embed?url=https%3A%2F%2Fwww.naturpark-saale-unstrut.de%2Fentwicklung-ehemaliger-forellenteichkulisse-als-laichhabitate-fuer-amphibien-und-trittsteinbiotop%2F&amp;format=xml\" rel=\"alternate\" title=\"oEmbed (XML)\" type=\"text/xml+oembed\"/>\n\n\n<link href=\"https://www.naturpark-saale-unstrut.de/wp-includes/css/dist/block-library/style.min.css?ver=7.1.4\" id=\"wp-block-library-css\" media=\"all\" rel=\"stylesheet\"/>\n\n<link href=\"https://www.na