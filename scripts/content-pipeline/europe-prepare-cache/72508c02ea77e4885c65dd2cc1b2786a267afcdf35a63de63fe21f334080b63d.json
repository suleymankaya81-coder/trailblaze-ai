go-Thirri_National_Park_banner.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"}, "thumbattribs": {"src": "https://thumb.wikimedia.org/wikipedia/commons/thumb/b/be/Mungo-Thirri_National_Park_banner.jpg/1280px-Mungo-Thirri_National_Park_banner.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "decoding": "async", "loading": "lazy", "width": 1280, "height": 183, "srcset": "https://thumb.wikimedia.org/wikipedia/commons/thumb/b/be/Mungo-Thirri_National_Park_banner.jpg/3840px-Mungo-Thirri_National_Park_banner.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"}, "url": "https://upload.wikimedia.org/wikipedia/commons/b/be/Mungo-Thirri_National_Park_banner.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "descriptionurl": "https://commons.wikimedia.org/wiki/File:Mungo-Thirri_National_Park_banner.jpg", "descriptionshorturl": "https://commons.wikimedia.org/wiki/Special:Redirect/page/113600916", "extmetadata": {"DateTime": {"value": "2021-12-23 20:38:37", "source": "mediawiki-metadata", "hidden": ""}, "ObjectName": {"value": "Mungo-Thirri National Park banner", "source": "mediawiki-metadata"}, "CommonsMetadataExtension": {"value": 1.2, "source": "extension", "hidden": ""}, "Categories": {"value": "Munga-Thirri National Park|Extracted images|Wikivoyage banners of Queensland|Wikivoyage banners by SHB", "source": "commons-categories", "hidden": ""}, "Assessments": {"value": "", "source": "commons-categories", "hidden": ""}, "ImageDescription": {"value": "Simpson DSC02971 SA", "source": "commons-desc-page"}, "DateTimeOriginal": {"value": "2017-11-08 07:06", "source": "commons-desc-page"}, "Credit": {"value": "<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/iancochrane_2011/38250485801/\">Simpson DSC02971 SA</a>", "source": "commons-desc-page"}, "Artist": {"value": "<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/62177177@N08\">Ian Cochrane</a> from Melbourne, Australia", "source": "commons-desc-page"}, "LicenseShortName": {"value": "CC BY 2.0", "source": "commons-desc-page", "hidden": ""}, "UsageTerms": {"value": "Creative Commons Attribution 2.0", "source": "commons-desc-page"}, "AttributionRequired": {"value": "true", "source": "commons-desc-page", "hidden": ""}, "LicenseUrl": {"value": "https://creativecommons.org/licenses/by/2.0", "source": "commons-desc-page"}, "Copyrighted": {"value": "True", "source": "commons-desc-page", "hidden": ""}, "Restrictions": {"value": "", "source": "commons-desc-page", "hidden": ""}, "License": {"value": "cc-by-2.0", "source": "commons-templates", "hidden": ""}}}]}, {"pageid": 135354854, "ns": 6, "title": "File:Australia's Simpson Desert (MODIS).jpg", "index": 6, "imagerepository": "local", "imageinfo": [{"size": 946228, "width": 1691, "height": 1246, "thumburl": "https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ee/Australia%27s_Simpson_Desert_%28MODIS%29.jpg/1280px-Australia%27s_Simpson_Desert_%28MODIS%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "thumbwidth": 1280, "thumbheight": 943, "responsiveUrls": {"2": "https://upload.wikimedia.org/wikipedia/commons/e/ee/Australia%27s_Simpson_Desert_%28MODIS%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"}, "thumbattribs": {"src": "https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ee/Australia%27s_Simpson_Desert_%28MODIS%29.jpg/1280px-Australia%27s_Simpson_Desert_%28MODIS%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "decoding": "async", "loading": "lazy", "width": 1280, "height": 943, "srcset": "https://upload.wikimedia.org/wikipedia/commons/e/ee/Australia%27s_Simpson_Desert_%28MODIS%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"}, "url": "https://upload.wikimedia.org/wikipedia/commons/e/ee/Australia%27s_Simpson_Desert_%28MODIS%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "descriptionurl": "https://commons.wikimedia.org/wiki/File:Australia%27s_Simpson_Desert_(MODIS).jpg", "descriptionshorturl": "https://commons.wikimedia.org/wiki/Special:Redirect/page/135354854", "extmetadata": {"DateTime": {"value": "2023-07-31 18:21:12", "source": "mediawiki-metadata", "hidden": ""}, "ObjectName": {"value": "Australia's Simpson Desert (MODIS)", "source": "mediawiki-metadata"}, "CommonsMetadataExtension": {"value": 1.2, "source": "extension", "hidden": ""}, "Categories": {"value": "PD NASA|Simpson Desert|Photographs taken on 2023-07-14|2023 MODIS images|Files from NASA with known IDs|Photos of lakes by the Terra (satellite) MODIS|Photos of Australia by the Terra (satellite) MODIS|Photos of floods by the Terra (satellite) MODIS|Satellite pictures of deserts|NASA Library files uploaded by OptimusPrimeBot|MODIS files uploaded by OptimusPrimeBot", "source": "commons-categories", "hidden": ""}, "Assessments": {"value": "", "source": "commons-categories", "hidden": ""}, "ImageDescription": {"value": "The deep red sands of Australia’s Simpson Desert shimmered in the winter’s sunlight on July 14, 2023, when the Moderate Resolution Imaging Spectroradiometer (MODIS) on NASA’s Terra satellite acquired this true-color image.\n<p>The fourth-largest desert in Australia, this iconic desert spans about 68,000 square miles (176,500 sq km) across the border of Northern Territory, South Australia and Queensland. Sometimes called the “Holy Grail of 4-wheel driving”, the vast tract of expansive desert is also famous for massive dunes, and a very dark sky that allows for spectacular starry nights. The parallel dunes can rise as high as 120 feet (37 m).\n</p><p>Although extremely arid—most of the desert receives only 5 inches (12.5 cm) of rain annually—parts of the desert are prone to flooding due to runoff from heavy rain events outside of the Simpson. When doused by moisture, either from rain or floods, the desert comes alive. Wildflowers bloom, plants green up and grow, and animals congregate around formerly-dry salt pans.\n</p>\nThe Munga-Thirri-Simpson Desert National Park sits in the center of the desert, and it is the largest national park in Australia. This park encompasses and protects the famous parallel sand dunes as well as a variety of other dunal systems. It is also notable for its extensive playa lakes (salt pans), spinifex grasslands and acacia woodlands.", "source": "commons-desc-page"}, "DateTimeOriginal": {"value": "Taken on 14 July 2023", "source": "commons-desc-page"}, "Credit": {"value": "This image or video was catalogued by Goddard Space Flight Center of the United States <a href=\"https://en.wikipedia.org/wiki/NASA\" class=\"extiw\" title=\"w:NASA\">National Aeronautics and Space Administration</a> (NASA) under <b>Photo ID:</b> <a rel=\"nofollow\" class=\"external text\" href=\"https://images.nasa.gov/search?q=2023-07-16&amp;page=1&amp;media=image,video,audio&amp;yearStart=1920&amp;yearEnd=2026\">2023-07-16</a>.", "source": "commons-desc-page"}, "Artist": {"value": "MODIS Land Rapid Response Team, NASA GSFC", "source": "commons-desc-page"}, "LicenseShortName": {"value": "Public domain", "source": "commons-desc-page", "hidden": ""}, "UsageTerms": {"value": "Public domain", "source": "commons-desc-page"}, "AttributionRequired": {"value": "false", "source": "commons-desc-page", "hidden": ""}, "Copyrighted": {"value": "False", "source": "commons-desc-page", "hidden": ""}, "Restrictions": {"value": "", "source": "commons-desc-page", "hidden": ""}, "License": {"value": "pd", "source": "commons-templates", "hidden": ""}}}]}, {"pageid": 143753697, "ns": 6, "title": "File:Munga-Thirri–Simpson Desert National Park (MODIS 2022-07-14).jpg", "index": 2, "imagerepository": "local", "imageinfo": [{"size": 1166875, "width": 2152, "height": 1482, "thumburl": "https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f9/Munga-Thirri%E2%80%93Simpson_Desert_National_Park_%28MODIS_2022-07-14%29.jpg/1280px-Munga-Thirri%E2%80%93Simpson_Desert_National_Park_%28MODIS_2022-07-14%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "thumbwidth": 1280, "thumbheight": 881, "responsiveUrls": {"2": "https://upload.wikimedia.org/wikipedia/commons/f/f9/Munga-Thirri%E2%80%93Simpson_Desert_National_Park_%28MODIS_2022-07-14%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"}, "thumbattribs": {"src": "https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f9/Munga-Thirri%E2%80%93Simpson_Desert_National_Park_%28MODIS_2022-07-14%29.jpg/1280px-Munga-Thirri%E2%80%93Simpson_Desert_National_Park_%28MODIS_2022-07-14%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "decoding": "async", "loading": "lazy", "width": 1280, "height": 881, "srcset": "https://upload.wikimedia.org/wikipedia/commons/f/f9/Munga-Thirri%E2%80%93Simpson_Desert_National_Park_%28MODIS_2022-07-14%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"}, "url": "https://upload.wikimedia.org/wikipedia/commons/f/f9/Munga-Thirri%E2%80%93Simpson_Desert_National_Park_%28MODIS_2022-07-14%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "descriptionurl": "https://commons.wikimedia.org/wiki/File:Munga-Thirri%E2%80%93Simpson_Desert_National_Park_(MODIS_2022-07-14).jpg", "descriptionshorturl": "https://commons.wikimedia.org/wiki/Special:Redirect/page/143753697", "extmetadata": {"DateTime": {"value": "2024-01-09 21:57:01", "source": "mediawiki-metadata", "hidden": ""}, "ObjectName": {"value": "Munga-Thirri–Simpson Desert National Park (MODIS 2022-07-14)", "source": "mediawiki-metadata"}, "CommonsMetadataExtension": {"value": 1.2, "source": "extension", "hidden": ""}, "Categories": {"value": "PD NASA|Munga-Thirri National Park|Munga-Thirri—Simpson Desert Conservation Park|Photographs taken on 2022-07-12|2022 MODIS images|Files from NASA with known IDs|Photos of Australia by the Terra (satellite) MODIS|MODIS files uploaded by OptimusPrimeBot", "source": "commons-categories", "hidden": ""}, "Assessments": {"value": "", "source": "commons-categories", "hidden": ""}, "ImageDescription": {"value": "Sand and salt playas crea te high-contrast scenery in the Munga-Thirri - Simpson Desert Conservation Park. The Moderate Resolution Imaging Spectroradiometer (MODIS) on board NASA’s Terra satellite acquired this true-color, sunshine-filled image of the arid desert on July 11, 2022.\nThe Munga-Thirri-Simpson Desert Conservation Park sits in north-eastern South Australia, and spans 3.6 million hectares, making it Australia’s biggest national park. This is only part of the entire Simpson Desert, a huge intact desert system which also stretches into Northern Territory and Queensland. It is famous for its massive acreage filled with parallel, linear sand dunes that have formed as a result of wind erosion and sand deposition taking place over thousands of years. Some of the dunes stretch more than 100 km (60 miles) in length. Almost as spectacular, especially when seen from space, are the extensive array of playa (salt) lakes. These are flat, shallow lake beds that are covered with a layer of salt deposits. When flushes of rain come to the desert, these playa lakes may become temporarily moistened, but for much of the year most remain dry. They appear bright white because of the high reflectivity of the salt and minerals that encrust the lakes.", "source": "commons-desc-page"}, "DateTimeOriginal": {"value": "Taken on 12 July 2022", "source": "commons-desc-page"}, "Credit": {"value": "This image or video was catalogued by Goddard Space Flight Center of the United States <a href=\"https://en.wikipedia.org/wiki/NASA\" class=\"extiw\" title=\"w:NASA\">National Aeronautics and Space Administration</a> (NASA) under <b>Photo ID:</b> <a rel=\"nofollow\" class=\"external text\" href=\"https://images.nasa.gov/search?q=2022-07-14&amp;page=1&amp;media=image,video,audio&amp;yearStart=1920&amp;yearEnd=2026\">2022-07-14</a>.", "source": "commons-desc-page"}, "Artist": {"value": "MODIS Land Rapid Response Team, NASA GSFC", "source": "commons-desc-page"}, "LicenseShortName": {"value": "Public domain", "source": "commons-desc-page", "hidden": ""}, "UsageTerms": {"value": "Public domain", "source": "commons-desc-page"}, "AttributionRequired": {"value": "false", "source": "commons-desc-page", "hidden": ""}, "Copyrighted": {"value": "False", "source": "commons-desc-page", "hidden": ""}, "Restrictions": {"value": "", "source": "commons-desc-page", "hidden": ""}, "License": {"value": "pd", "source": "commons-templates", "hidden": ""}}}]}]}}