ssments": {"value": "", "source": "commons-categories", "hidden": ""}, "ImageDescription": {"value": "This image, acquired by one of the Copernicus Sentinel-2 satellites on 22 May 2023, shows the Muddus National Park in Sweden. Spanning over 500 square kilometres, this park represents a unique and well-preserved example of boreal forest ecosystems. Its landscapes showcase the key characteristics of boreal forests, such as the dominance of coniferous tree species such as spruce and pine, which have adapted to the harsh climatic conditions of the region. Boreal forests safeguard biodiversity, uphold ecosystem functions, and contribute to climate change mitigation efforts.", "source": "commons-desc-page"}, "DateTimeOriginal": {"value": "2023-05-22", "source": "commons-desc-page"}, "Credit": {"value": "<a rel=\"nofollow\" class=\"external free\" href=\"https://www.copernicus.eu/en/media/image-day-gallery/muddus-national-park-sweden\">https://www.copernicus.eu/en/media/image-day-gallery/muddus-national-park-sweden</a>", "source": "commons-desc-page"}, "Artist": {"value": "European Union, Copernicus Sentinel-2 imagery", "source": "commons-desc-page"}, "LicenseShortName": {"value": "Attribution", "source": "commons-desc-page", "hidden": ""}, "Attribution": {"value": "Contains modified Copernicus Sentinel data 2023", "source": "commons-desc-page", "hidden": ""}, "Restrictions": {"value": "", "source": "commons-desc-page", "hidden": ""}}}]}]}}