}, "Assessments": {"value": "quality|featured|poty", "source": "commons-categories", "hidden": ""}, "ImageDescription": {"value": "<a href=\"https://en.wikipedia.org/wiki/Algar_do_Carv%C3%A3o\" class=\"extiw\" title=\"en:Algar do Carvão\">Algar do Carvão</a> (in Portuguese <i>Blackened Crease</i>), <a href=\"https://en.wikipedia.org/wiki/Terceira_Island\" class=\"extiw\" title=\"en:Terceira Island\">Terceira Island</a>, <a href=\"https://en.wikipedia.org/wiki/Azores\" class=\"extiw\" title=\"en:Azores\">Azores</a>, Portugal. The image shows the approx. 50 metres (160 ft) long Boca do Algar (in Portuguese \"Mouth of the Cavern\") viewed from the bottom of an ancient volcanic vent. The site, located in the center of the island, has become a popular tourist magnet.", "source": "commons-desc-page"}, "DateTimeOriginal": {"value": "Taken on 25 July 2020, 16:48:10", "source": "commons-desc-page"}, "Credit": {"value": "<span class=\"int-own-work\" lang=\"en\">Own work</span>", "source": "commons-desc-page"}, "Artist": {"value": "<bdi><a href=\"https://www.wikidata.org/wiki/Q28147777\" class=\"extiw\" title=\"d:Q28147777\"><span title=\"Spanish photographer\">Diego Delso</span></a></bdi>", "source": "commons-desc-page"}, "Permission": {"value": "<table style=\"margin: 1.5em auto; width:90%; color:inherit; background-color:var(--background-color-progressive-subtle, #CED8F6); border: 2px solid var(--border-color-subtle, #cccccc); padding:1px;\" cellspacing=\"10\" dir=\"ltr\" class=\"layouttemplate\">\n\n<tbody><tr>\n<td align=\"center\"><small>Another one of my pictures:<br></small><span typeof=\"mw:File\"><a href=\"//commons.wikimedia.org/wiki/File:Raya_pel%C3%A1gica_(Pteroplatytrygon_violacea),_Cabo_de_Palos,_Espa%C3%B1a,_2022-07-16,_DD_69.jpg\" class=\"mw-file-description\"><img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f5/Raya_pel%C3%A1gica_%28Pteroplatytrygon_violacea%29%2C_Cabo_de_Palos%2C_Espa%C3%B1a%2C_2022-07-16%2C_DD_69.jpg/250px-Raya_pel%C3%A1gica_