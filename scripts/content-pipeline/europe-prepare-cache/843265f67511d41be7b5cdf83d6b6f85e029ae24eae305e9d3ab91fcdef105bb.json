righted": {"value": "False", "source": "commons-desc-page", "hidden": ""}, "Restrictions": {"value": "", "source": "commons-desc-page", "hidden": ""}, "License": {"value": "pd", "source": "commons-templates", "hidden": ""}}}]}, {"pageid": 136505207, "ns": 6, "title": "File:Saharan dust turns Pyrénées (Ariège Pyrénées Regional Natural Park) snow brownish.jpg", "index": 1, "imagerepository": "local", "imageinfo": [{"size": 1271523, "width": 3507, "height": 2540, "thumburl": "https://thumb.wikimedia.org/wikipedia/commons/thumb/2/28/Saharan_dust_turns_Pyr%C3%A9n%C3%A9es_%28Ari%C3%A8ge_Pyr%C3%A9n%C3%A9es_Regional_Natural_Park%29_snow_brownish.jpg/1280px-Saharan_dust_turns_Pyr%C3%A9n%C3%A9es_%28Ari%C3%A8ge_Pyr%C3%A9n%C3%A9es_Regional_Natural_Park%29_snow_brownish.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "thumbwidth": 1280, "thumbheight": 927, "responsiveUrls": {"2": "https://upload.wikimedia.org/wikipedia/commons/2/28/Saharan_dust_turns_Pyr%C3%A9n%C3%A9es_%28Ari%C3%A8ge_Pyr%C3%A9n%C3%A9es_Regional_Natural_Park%29_snow_brownish.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"}, "thumbattribs": {"src": "https://thumb.wikimedia.org/wikipedia/commons/thumb/2/28/Saharan_dust_turns_Pyr%C3%A9n%C3%A9es_%28Ari%C3%A8ge_Pyr%C3%A9n%C3%A9es_Regional_Natural_Park%29_snow_brownish.jpg/1280px-Saharan_dust_turns_Pyr%C3%A9n%C3%A9es_%28Ari%C3%A8ge_Pyr%C3%A9n%C3%A9es_Regional_Natural_Park%29_snow_brownish.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "decoding": "async", "loading": "lazy", "width": 1280, "height": 927, "srcset": "https://upload.wikimedia.org/wikipedia/commons/2/28/Saharan_dust_turns_Pyr%C3%A9n%C3%A9es_%28Ari%C3%A8ge_Pyr%C3%A9n%C3%A9es_Regional_Natural_Park%29_snow_brownish.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"}, "url": "https://upload.wikimedia.org/wikipedia/commons/2/28/Saharan_dust_turns_Pyr%C3%A9n%C3%A9es_%28Ari%C3%A8ge_Pyr%C3%A9n%C3%A9es_Regional_Natural_Park%29_snow_brownish.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "descriptionurl": "https://commons.wikimedia.org/wiki/File:Saharan_dust_turns_Pyr%C3%A9n%C3%A9es_(Ari%C3%A8ge_Pyr%C3%A9n%C3%A9es_Regional_Natural_Park)_snow_brownish.jpg", "descriptionshorturl": "https://commons.wikimedia.org/wiki/Special:Redirect/page/136505207", "extmetadata": {"DateTime": {"value": "2023-08-27 08:15:43", "source": "mediawiki-metadata", "hidden": ""}, "ObjectName": {"value": "Saharan dust turns Pyrénées (Ariège Pyrénées Regional Natural Park) snow brownish", "source": "mediawiki-metadata"}, "CommonsMetadataExtension": {"value": 1.2, "source": "extension", "hidden": ""}, "Categories": {"value": "Attribution Copernicus|Photographs taken on 2021-02-06|2021 satellite pictures|Photos of France by Sentinel-2|Copernicus files uploaded by OptimusPrimeBot", "source": "commons-categories", "hidden": ""}, "Assessments": {"value": "", "source": "commons-categories", "hidden": ""}, "ImageDescription": {"value": "A massive Saharan dust plume with high values of dust aerosol and surface PM10 is sweeping across southwestern Europe. It has painted the snow in the Pyrénées mountain range (and also in the Alps) in brownish colours and turned the skies orange . This episode had been forecasted by the Copernicus Atmosphere Monitoring Service. Such events have been documented in the scientific literature. For example, a 2019 study entitled, “Saharan dust events in the European Alps: role in snowmelt and geochemical characterization” was published in The Cryosphere. The paper concluded that Saharan dust reduces snow cover duration in Europe. Through a process called the snow-albedo feedback, dust darkens snow making it less reflective, which leads to increased snowmelt over time. These dust episodes also represent a major environmental and health hazard. This true colours image, acquired by one of the Copernicus Sentinel-2 satellites on 6 February 2021, shows dust covered snow in the Ariège Pyrénées Regional Natural Park in southeast France. Open Data supplied by the Copernicus Sentinel satellites and forecasts from the Copernicus Atmosphere Monitoring Service enable to provide early warning and to monitor the impacts of Saharan dust episodes and other pollution peaks.", "source": "commons-desc-page"}, "DateTimeOriginal": {"value": "Taken on 6 February 2021", "source": "commons-desc-page"}, "Credit": {"value": "<a rel=\"nofollow\" class=\"external text\" href=\"https://www.copernicus.eu/en/media/image-day-gallery/saharan-dust-turns-pyrenees-ariege-pyrenees-regional-natural-park-snow\">Saharan dust turns Pyrénées (Ariège Pyrénées Regional Natural Park) snow brownish</a>", "source": "commons-desc-page"}, "Artist": {"value": "European Union , Copernicus Sentinel-2  imagery", "source": "commons-desc-page"}, "LicenseShortName": {"value": "Attribution", "source": "commons-desc-page", "hidden": ""}, "Attribution": {"value": "Contains modified Copernicus Sentinel data 2021", "source": "commons-desc-page", "hidden": ""}, "Restrictions": {"value": "", "source": "commons-desc-page", "hidden": ""}}}]}]}}