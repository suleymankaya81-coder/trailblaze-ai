{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WildParkRoutes source-bound Nordic Claude results",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "status", "hold_reason"],
        "properties": {
          "slug": {"type": "string", "minLength": 1},
          "status": {"const": "hold"},
          "hold_reason": {"type": "string", "minLength": 10},
          "sources": {"type": "array", "items": {"type": "string", "format": "uri"}}
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "status", "tagline", "summary", "best_season", "days", "sources"],
        "properties": {
          "slug": {"type": "string", "minLength": 1},
          "status": {"const": "ok"},
          "tagline": {"type": "string", "maxLength": 90},
          "summary": {"type": "string", "minLength": 250, "maxLength": 900},
          "best_season": {"enum": ["spring", "summer", "autumn", "winter", "year_round", "spring_autumn", "summer_autumn"]},
          "reservation_note": {"type": ["string", "null"]},
          "operational_source_date": {"type": ["string", "null"]},
          "access_note": {"type": ["string", "null"]},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
          "days": {
            "type": "array", "minItems": 1, "maxItems": 3,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["day", "title", "stops"],
              "properties": {
                "day": {"type": "integer", "minimum": 1, "maximum": 3},
                "title": {"type": "string", "minLength": 1},
                "stops": {
                  "type": "array", "minItems": 1, "maxItems": 5,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["name", "what", "source_url", "source_quote"],
                    "properties": {
                      "name": {"type": "string", "minLength": 1},
                      "what": {"type": "string", "maxLength": 280},
                      "lat": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
                      "lng": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
                      "source_url": {"type": "string", "format": "uri"},
                      "source_quote": {"type": "string", "minLength": 10}
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  }
}