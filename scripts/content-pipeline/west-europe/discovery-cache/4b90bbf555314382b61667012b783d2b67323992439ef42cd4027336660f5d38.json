</div>\n  </div>\n\t\n\t\t\t</div>\n\t\t\t\n\t\t\t  <div class=\"l-region l-region--main-menu\">\n    <div class=\"panel-pane pane-block pane-menu-block-2 dahg-main-menu\"   class=\"panel-pane pane-block pane-menu-block-2 dahg-main-menu\">\n    \n  \n  \n  \n  <div class=\"pane-content\">\n    <div class=\"menu-block-wrapper menu-block-2 menu-name-main-menu parent-mlid-0 menu-level-1\">\n  <ul class=\"menu\"><li class=\"first leaf menu-mlid-1475\"><a href=\"/national-parks\" title=\"Information about National Parks in Ireland\">National Parks</a></li>\n<li class=\"leaf has-children menu-mlid-1459\"><a href=\"/protected-sites\" title=\"Information about Protected Sites in Ireland\">Protected Sites</a></li>\n<li class=\"leaf has-children menu-mlid-1651\"><a href=\"/nature-reserves\" title=\"Information about Nature Reserves (areas of importance to wildlife, protected under Ministerial order) in Ireland\">Nature Reserves</a></li>\n<li class=\"leaf has-children menu-mlid-1458\"><a href=\"/publications\" title=\"Search or browse NPWS published and unpublished reports\">Publications</a></li>\n<li class=\"leaf has-children menu-mlid-2071\"><a href=\"/licencesandconsents\" title=\"\">Licences</a></li>\n<li class=\"leaf has-children menu-mlid-2095\"><a href=\"/maps-and-data\" title=\"\">Maps and Data</a></li>\n<li class=\"last leaf menu-mlid-3097\"><a href=\"/development-consultations\" title=\"A guide to development consultations\">Planning</a></li>\n</ul></div>\n  </div>\n\n  \n  </div>\n  </div>\n\t\t</div>\n   </header>\n\n    <div class=\"l-main\">\n\n\t\t  <div class=\"l-region l-region--breadcrumb\">\n    <div class=\"panel-pane pane-page-breadcrumb\"   class=\"panel-pane pane-page-breadcrumb\">\n    \n  \n  \n  \n  <div class=\"pane-content\">\n    <h2 class=\"element-invisible\">You are here</h2><div class=\"dahg-breadcrumb\"><a href=\"/\">Home</a> &gt; <a href=\"/nature-reserves\">Nature Reserves</a> &gt; Kilkenny</div>  </div>\n\n  \n  </div>\n  </div>\n\n\t\t  <aside class=\"l-region l-region--sidebar\">\n    <div class=\"panel-pane pane-views-panes pane-nature-reserves-panel-counties\"   class=\"panel-pane pane-views-panes pane-nature-reserves-panel-counties\">\n    \n  \n  \n  \n  <div class=\"pane-content\">\n    <div class=\"view view-nature-reserves view-id-nature_reserves view-display-id-panel_counties view-dom-id-24bd0a8724bac269adfe1198a0b9b548\">\n        \n  \n  \n      <div class=\"view-content\">\n      <div class=\"dahg-sidebar-menu\">\n<ul class=\"menu\">\n      <li class=\"leaf\">\n      <a href=\"/nature-reserves/clare\">Clare</a>\n    </li>\n\t    <li class=\"leaf\">\n      <a href=\"/nature-reserves/cork\">Cork</a>\n    </li>\n\t    <li class=\"leaf\">\n      <a href=\"/nature-reserves/donegal\">Donegal</a>\n    </li>\n\t    <li class=\"leaf\">\n      <a href=\"/nature-reserves/dublin\">Dublin</a>\n    </li>\n\t    <li class=\"leaf\">\n      <a href=\"/nature-reserves/galway\">Galway</a>\n    </li>\n\t    <li class=\"leaf\">\n      <a href=\"/nature-reserves/kerry\">Kerry</a>\n    </li>\n\t    <li class=\"leaf\">\n      <a href=\"/nature-reserves/kildare\">Kildare</a>\n    </li>\n\t    <li class=\"leaf\">\n      <a href=\"/nature-reserves/kilkenny\">Kilkenny</a>\n    </li>\n\t    <li class=\"leaf\">\n      <a href=\"/nature-reserves/laois\">Laois</a>\n    </li>\n\t    <li class=\"leaf\">\n      <a href=\"/nature-reserves/mayo\">Mayo</a>\n    </li>\n\t    <li class=\"leaf\">\n      <a href=\"/nature-reserves/meath\">Meath</a>\n    </li>\n\t    <li class=\"leaf\">\n      <a href=\"/nature-reserves/offaly\">Offaly</a>\n    </li>\n\t    <li class=\"leaf\">\n      <a href=\"/nature-reserves/sligo\">Sligo</a>\n    </li>\n\t    <li class=\"leaf\">\n      <a href=\"/nature-reserves/tipperary\">Tipperary</a>\n    </li>\n\t    <li class=\"leaf\">\n      <a href=\"/nature-reserves/westmeath\">Westmeath</a>\n    </li>\n\t    <li class=\"leaf\">\n      <a href=\"/nature-reserves/wexford\">Wexford</a>\n    </li>\n\t    <li class=\"leaf\">\n      <a href=\"/nature-reserves/wicklow\">Wicklow</a>\n    </li>\n\t</ul>\n</div>\n    </div>\n  \n  \n  \n  \n  \n  \n</div>  </div>\n\n  \n  </div>\n  </aside>\n\n\t\t<div class=\"l-region--content\" role=\"main\">\n\t\t\t<div class=\"l-content\">\n\t\t\t\t<div class=\"panel-pane pane-page-title\"   class=\"panel-pane pane-page-title\">\n    \n  \n  \n  \n  <div class=\"pane-content\">\n    <h1>Kilkenny</h1>\n  </div>\n\n  \n  </div>\n<div class=\"panel-pane pane-page-content\"   class=\"panel-pane pane-page-content\">\n    \n  \n  \n  \n  <div class=\"pane-content\">\n    <div class=\"view view-nature-reserves view-id-nature_reserves view-display-id-county_page view-dom-id-1cad92506307f91d09f2d2ed2cac6377\">\n        \n  \n  \n      <div class=\"view-content\">\n        <div class=\"views-row views-row-1 views-row-odd views-row-first\">\n      \n  <div>        <div class=\"reserve-view-heading-wrapper\">\n<div class=\"reserve-view-label-edit\"><h2>Ballykeeffe Wood Nature Reserve</h2></div>\n<div class=\"reserve-view-edit\"></div>\n</div>  </div>  \n  <div class=\"reserve-view-wrapper\">    <div class=\"reserve-view-label\">Location: </div>    <div class=\"reserve-view-text\">12 km south-west of Kilkenny situated on a prominent limestone hill.</div>  </div>  \n          <div class=\"reserve-view-wrapper\">\n<div class=\"reserve-view-label\">GPS:</div>\n<div class=\"reserve-view-text\">Latitude: 52.612<br />Longitude: -7.394</div>\n</div>    \n  <div class=\"reserve-view-wrapper\">    <div class=\"reserve-view-label\">Area (ha.): </div>    <div class=\"reserve-view-text\">55.4</div>  </div>  \n  <div class=\"reserve-view-wrapper\">        <div class=\"reserve-view-text-block\"></div>  </div>  \n  <div class=\"reserve-view-wrapper\">    <div class=\"reserve-view-label-block\">Animals and plants of interest: </div>    <div class=\"reserve-view-text-block\">A young ash woodland with pedunculate oak and abundant bramble and bluebells.</div>  </div>  \n  <div class=\"reserve-view-wrapper\">        <div class=\"reserve-view-established\">\n    <div class=\"reserve-view-label\">Established:</div>\n    <div class=\"reserve-view-text\"></div>\n</div>\n<div class=\"reserve-view-ownership\">\n    <div class=\"reserve-view-label\">Ownership:</div>\n    <div class=\"reserve-view-text\">State-owned</div>\n</div>  </div>  </div>\n  <div class=\"views-row views-row-2 views-row-even\">\n      \n  <div>        <div class=\"reserve-view-heading-wrapper\">\n<div class=\"reserve-view-label-edit\"><h2>Fiddown Island Nature Reserve</h2></div>\n<div class=\"reserve-view-edit\"></div>\n</div>  </div>  \n  <div class=\"reserve-view-wrapper\">    <div class=\"reserve-view-label\">Location: </div>    <div class=\"reserve-view-text\">7 km east of Carrick-on-Suir.</div>  </div>  \n          <div class=\"reserve-view-wrapper\">\n<div class=\"reserve-view-label\">GPS:</div>\n<div class=\"reserve-view-text\">Latitude: 53.068<br />Longitude: -7.93</div>\n</div>    \n  <div class=\"reserve-view-wrapper\">    <div class=\"reserve-view-label\">Area (ha.): </div>    <div class=\"reserve-view-text\">21</div>  </div>  \n  <div class=\"reserve-view-wrapper\">        <div class=\"reserve-view-text-block\"></div>  </div>  \n  <div class=\"reserve-view-wrapper\">    <div class=\"reserve-view-label-block\">Animals and plants of interest: </div>    <div class=\"reserve-view-text-block\">An alluvial woodland dominated by tree willows formerly used for basket making. The vegetation is characterised by tall herbs, sedges and grasses. It is covered in willow scrub and bordered by reed swamps - the only known site of its type in Ireland.</div>  </div>  \n  <div class=\"reserve-view-wrapper\">        <div class=\"reserve-view-established\">\n    <div class=\"reserve-view-label\">Established:</div>\n    <div class=\"reserve-view-text\">1988</div>\n</div>\n<div class=\"reserve-view-ownership\">\n    <div class=\"reserve-view-label\">Ownership:</div>\n    <div class=\"reserve-view-text\">State-owned</div>\n</div>  </div>  </div>\n  <div class=\"views-row views-row-3 views-row-odd\">\n      \n  <div>        <div class=\"reserve-view-heading-wrapper\">\n<div class=\"reserve-view-label-edit\"><h2>Garryricken Woods Nature Reserve</h2></div>\n<div class=\"reserve-view-edit\"></div>\n</div>  </div>  \n  <div class=\"reserve-view-wrapper\">    <div class=\"reserve-view-label\">Location: </div>    <div class=\"reserve-view-text\">6 km south-west of Callan</div>  </div>  \n          <div class=\"reserve-view-wrapper\">\n<div class=\"reserve-view-label\">GPS:</div>\n<div class=\"reserve-view-text\">Latitude: 52.497<br />Longitude: -7.412</div>\n</div>    \n  <div class=\"reserve-view-wrapper\">    <div class=\"reserve-view-label\">Area (ha.): </div>    <div class=\"reserve-view-text\">28</div>  </div>  \n  <div class=\"reserve-view-wrapper\">        <div class=\"reserve-view-text-block\"></div>  </div>  \n  <div class=\"reserve-view-wrapper\">    <div class=\"reserve-view-label-block\">Animals and plants of interest: </div>    <div class=\"reserve-view-text-block\">This reserve consists of two parts and contains a mixture of ash, oak and birch woodland on a variety of soil types.</div>  </div>  \n  <div class=\"reserve-view-wrapper\">        <div class=\"reserve-view-established\">\n    <div class=\"reserve-view-label\">Established:</div>\n    <div class=\"reserve-view-text\"></div>\n</div>\n<div class=\"reserve-view-ownership\">\n    <div class=\"reserve-view-label\">Ownership:</div>\n    <div class=\"reserve-view-text\">State-owned</div>\n</div>  </div>  </div>\n  <div class=\"views-row views-row-4 views-row-even views-row-last\">\n      \n  <div>        <div class=\"reserve-view-heading-wrapper\">\n<div class=\"reserve-view-label-edit\"><h2>Kyledohir Wood Nature Reserve</h2></div>\n<div class=\"reserve-view-edit\"></div>\n</div>  </div>  \n  <div class=\"reserve-view-wrapper\">    <div class=\"reserve-view-label\">Location: </div>    <div class=\"reserve-view-text\">5 km south-west of Callan.</div>  </div>  \n          <div class=\"reserve-view-wrapper\">\n<div class=\"reserve-view-label\">GPS:</div>\n<div class=\"reserve-view-text\">Latitude: 52.533<br />Longitude: -7.453</div>\n</div>    \n  <div class=\"reserve-view-wrapper\">    <div class=\"reserve-view-label\">Area (ha.): </div>    <div class=\"reserve-view-text\">59</div>  </div>  \n  <div class=\"reserve-view-wrapper\">        <div class=\"reserve-view-text-block\"></div>  </div>  \n  <div class=\"reserve-view-wrapper\">    <div class=\"reserve-view-label-block\">Animals and plants of interest: </div>    <div class=\"reserve-view-text-block\">Mixed, young oak-ash-elm woodland on a low-lying site with moisture-loving species.</div>  </div>  \n  <div class=\"reserve-view-wrapper\">        <div class=\"reserve-view-established\">\n    <div class=\"reserve-view-label\">Established:</div>\n    <div class=\"reserve-view-text\"></div>\n</div>\n<div class=\"reserve-view-ownership\">\n    <div class=\"reserve-view-label\">Ownership:</div>\n    <div class=\"reserve-view-text\">State-owned</div>\n</div>  </div>  </div>\n    </div>\n  \n  \n  \n  \n  \n  \n</div>  </div>\n\n  \n  </div>\n\t\t\t</div>\n\t\t</div>\n  </div>\n  \n   <footer class=\"l-footer\" role=\"contentinfo\">\n      <div class=\"l-region l-region--footer-content\">\n    <div class=\"panel-pane pane-block pane-block-5 l-back-to-top\"   class=\"panel-pane pane-block pane-block-5 l-back-to-top\">\n    \n  \n  \n  \n  <div class=\"pane-content\">\n    <p><a href=\"#top\" title=\"Back to top\">Back to Top</a></p>\n  </div>\n\n  \n  </div>\n<div class=\"panel-pane pane-block pane-menu-menu-footer-menu l-footer-menu\"   class=\"panel-pane pane-block pane-menu-menu-footer-menu l-footer-menu\">\n    \n  \n  \n  \n  <div class=\"pane-content\">\n    <ul class=\"menu\"><li class=\"first expanded\"><span title=\"\" class=\"nolink\" tabindex=\"0\">Maps &amp; Data</span><ul class=\"men